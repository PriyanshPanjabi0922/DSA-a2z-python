nums = [1,192,1,2,199,100,101,104,103,102,3]

def solution(nums):
    n = len(nums)
    longest = 1

    for i in range(n):
        x = nums[i]
        cnt = 1

        while x+1 in nums:
            x +=1
            cnt+=1

        longest = max(longest,cnt)
    return longest

result = solution(nums)
print(result)
